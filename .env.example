# Modelo de configuração. O aplicativo lê variáveis de ambiente, não este arquivo.
DATABASE_PATH=data/anexo_desafio_1.db
# Provedor padrão: Gemini. Use LLM_PROVIDER=openai para trocar.
LLM_PROVIDER=gemini
GEMINI_API_KEY=substitua_pela_sua_chave
GEMINI_MODEL=gemini-3.1-flash-lite
